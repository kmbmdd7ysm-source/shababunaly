# SHABABUNA — public browser configuration
SITE_URL=https://shababuna.ly

# Analytics (optional; loads only after consent)
VITE_GA_MEASUREMENT_ID=
VITE_CLARITY_PROJECT_ID=
VITE_ANALYTICS_DEBUG=false

# Forms and order notifications
# Create a Formspree form that delivers to shababuna.info@gmail.com, then add its endpoint.
VITE_FORM_ENDPOINT=https://formspree.io/f/mvzenjgv
FORMSPREE_ENDPOINT=https://formspree.io/f/mvzenjgv
VITE_NEWSLETTER_ENDPOINT=
# Server-side Vercel value; may use the same endpoint.
FORMSPREE_ORDER_ENDPOINT=https://formspree.io/f/mvzenjgv

# Supabase accounts, profiles, saved state, inventory and orders
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Alternative names supported by the runtime:
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PUBLISHABLE_DEFAULT_KEY=

# International card / wallet checkout (Visa, Mastercard, Apple Pay, Google Pay)
VITE_PAYMENTS_PROVIDER=
VITE_PAYMENTS_PUBLISHABLE_KEY=
VITE_STRIPE_PUBLISHABLE_KEY=
VITE_CHECKOUT_API_BASE=/api
# Server-only values used by /api/create-session. Never prefix secrets with VITE_.
PAYMENTS_PROVIDER=
PAYMENTS_SESSION_URL=
PAYMENTS_SECRET_KEY=

PAYMENTS_RETRIEVE_URL=
PAYMENTS_REFUND_URL=
PAYMENTS_SIGNATURE_HEADER=x-shababuna-signature

# Libyan bank-card checkout
VITE_LIBYAN_BANK_CARD_PROVIDER=
VITE_LIBYAN_BANK_CARD_PUBLISHABLE_KEY=
VITE_LIBYAN_BANK_CARD_CHECKOUT_API_BASE=/api
# Server-only provider connection
LIBYAN_BANK_CARD_PROVIDER=
LIBYAN_BANK_CARD_SESSION_URL=
LIBYAN_BANK_CARD_SECRET_KEY=

LIBYAN_BANK_CARD_RETRIEVE_URL=
LIBYAN_BANK_CARD_REFUND_URL=
LIBYAN_BANK_CARD_SIGNATURE_HEADER=x-shababuna-signature


# Verified payment webhooks (server-only; use independent secrets)
PAYMENTS_WEBHOOK_SECRET=
LIBYAN_BANK_CARD_WEBHOOK_SECRET=
# Set to minor when providers send cents/dirhams, or major when they send USD amounts.
PAYMENTS_WEBHOOK_AMOUNT_UNIT=minor
LIBYAN_BANK_CARD_WEBHOOK_AMOUNT_UNIT=minor

# Reliable Formspree notification outbox worker
CRON_SECRET=
GUEST_ORDER_ACCESS_SECRET=

# Bot protection for public forms
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Development/test only. Never enable in production.
TURNSTILE_TEST_MODE=false

# Durable public API rate limiting
EDGE_RATE_LIMIT_SALT=

# Error monitoring (optional, no secrets in browser)
VITE_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
ERROR_MONITORING_INGEST_URL=
ERROR_MONITORING_TOKEN=


# Server-only trusted-order lookup for /api/create-session
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase Edge Function secrets (set with `supabase secrets set`)
# SUPABASE_SERVICE_ROLE_KEY=server-only
# EDGE_RATE_LIMIT_SALT=long-random-server-only-value

# Optional hosted MP4 for the main cinematic hero. Leave blank until final media is approved.
VITE_HERO_VIDEO_URL=
VITE_HERO_MOBILE_VIDEO_URL=

# Optional malware scanning adapter for quarantined uploads
MALWARE_SCAN_PROVIDER=
MALWARE_SCAN_API_URL=
MALWARE_SCAN_API_KEY=
MALWARE_SCAN_TEST_MODE=false

# Optional Redis/KV backing if used instead of the Supabase rate-limit RPC
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Privacy, retention and private media
PRIVACY_EXPORT_BUCKET=privacy-exports
MEDIA_QUARANTINE_BUCKET=media-quarantine
SECURITY_EVENT_RETENTION_DAYS=180
TELEMETRY_RETENTION_DAYS=90

# Keep false/empty in production. May be true only for isolated local/staging visual tests.

# Immutable build identifier used by the service worker cache namespace.
VITE_BUILD_ID=

# -----------------------------------------------------------------------------
# Production verification gates — never set these to true until the referenced
# evidence, credentials and live sandbox systems exist.
REQUIRE_LIVE_INTEGRATIONS=false
REQUIRE_PRODUCTION_CATALOG=false
REQUIRE_FINAL_MEDIA=false
REQUIRE_FACTORY_APPROVAL=false
REQUIRE_ARABIC_REVIEW=false
REQUIRE_REVIEWED_VISUAL_BASELINES=false
REQUIRE_PROVIDER_APPROVAL=false
REQUIRE_ZERO_STRICT_DEBT=false
FULL_STACK_E2E=false

# Payment-provider evidence and safe sandbox verification
PAYMENTS_PROVIDER_API_VERSION=
PAYMENTS_PROVIDER_DOCS_URL=
PAYMENTS_PROVIDER_SANDBOX_URL=
PAYMENTS_WEBHOOK_SCHEMA_VERSION=
ALLOW_LIVE_PAYMENT_TEST=false
PAYMENTS_SANDBOX_TEST_TRANSACTION_ID=
PAYMENTS_SANDBOX_TEST_REFUND_AMOUNT=0.01
PAYMENTS_SANDBOX_TEST_CURRENCY=USD
# Public browser values required to expose the card choice; never put a secret here.
VITE_SIGNATURE_PROVIDER=

# Third-party legal e-signature gateway. The provider must return an HTTPS
# signing URL and, on completion, a signed-document SHA-256 and audit-certificate
# SHA-256 through the verified webhook.
SIGNATURE_PROVIDER=
SIGNATURE_API_URL=
SIGNATURE_CREATE_ENVELOPE_URL=
SIGNATURE_API_KEY=
SIGNATURE_WEBHOOK_SECRET=
SIGNATURE_WEBHOOK_HEADER=x-signature
SIGNATURE_PROVIDER_SCHEMA_VERSION=
SIGNATURE_PROVIDER_DOCS_URL=
SIGNATURE_PROVIDER_SANDBOX_URL=
SIGNATURE_PROVIDER_TEST_ENVELOPE_ID=
SIGNATURE_TIMEOUT_MS=15000

# Live delivery verification for Formspree. Point this at a Mailpit/MailHog or
# enterprise test-inbox adapter that supports GET ?q=<marker> and returns a
# messages/items array with recipient fields.
ALLOW_LIVE_FORMSPREE_TEST=false
INTEGRATION_TEST_EMAIL=
FORMSPREE_ADMIN_RECIPIENT=shababuna.info@gmail.com
INTEGRATION_MAILBOX_API_URL=
INTEGRATION_MAILBOX_API_TOKEN=

# Explicit live malware verification
ALLOW_LIVE_MALWARE_TEST=false

# Google PageSpeed Insights production verification (public staging URL required)
PAGESPEED_URL=
PAGESPEED_API_KEY=
PAGESPEED_TIMEOUT_MS=120000

# Isolated E2E/staging services. Never point these values at production.
E2E_ENVIRONMENT_ID=
E2E_SITE_URL=
E2E_SUPABASE_URL=
E2E_SUPABASE_ANON_KEY=
E2E_SUPABASE_SERVICE_ROLE_KEY=
MAILPIT_API_URL=
E2E_PAYMENT_API_URL=
E2E_MALWARE_API_URL=
E2E_SIGNATURE_API_URL=
MALWARE_WORKER_URL=

# Delivery evidence must be created by a successful end-to-end test.
FORMSPREE_DELIVERY_VERIFIED_AT=
FORMSPREE_DELIVERY_EVIDENCE_ID=

# Repeated performance evidence.
LIGHTHOUSE_RUNS=5
PAGESPEED_RUNS=3
