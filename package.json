{
  "name": "shababuna-commerce",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "SHABABUNA — global basketball retail, custom manufacturing, teams and wholesale platform.",
  "scripts": {
    "dev": "vite",
    "validate:data": "node --experimental-strip-types scripts/validate-data.mjs",
    "build": "npm run validate:data && vite build",
    "preview": "vite preview",
    "audit:production": "npm audit --omit=dev",
    "test": "npm run test:node",
    "lint": "npm run lint:eslint && npm run lint:css && node scripts/check-source.mjs && node scripts/lint-project.mjs",
    "typecheck": "tsc --noEmit",
    "lint:css": "stylelint \"src/**/*.css\" \"src/**/*.scss\" --allow-empty-input",
    "lint:fix": "eslint src api e2e tests scripts --fix && stylelint \"src/**/*.css\" --fix --allow-empty-input && node scripts/check-source.mjs && node scripts/lint-project.mjs",
    "test:watch": "node --test --watch tests/*.test.js",
    "coverage": "npm run coverage:node && npm run coverage:project",
    "analyze": "node scripts/analyze.mjs",
    "validate:brand": "node scripts/validate-brand.mjs",
    "validate:media": "node --experimental-strip-types scripts/validate-media.mjs",
    "qa": "npm run qa:fast && npm run test:ui && npm run coverage:project && npm run build && npm run analyze",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate:commerce": "node scripts/validate-commerce.mjs",
    "test:e2e": "npm run build && npm run test:e2e:run",
    "lighthouse:mobile": "node scripts/lighthouse/run-lighthouse.mjs mobile",
    "lighthouse:desktop": "node scripts/lighthouse/run-lighthouse.mjs desktop",
    "lighthouse:validate": "node scripts/lighthouse/validate-lighthouse.mjs",
    "lighthouse": "npm run build && npm run lighthouse:mobile && npm run lighthouse:desktop && npm run lighthouse:validate",
    "qa:fast": "npm run format:check && npm run lint && npm run typecheck && npm run typecheck:strict-critical && npm run typecheck:production && npm run audit:typescript && npm run test:node && npm run coverage:node && npm run verify:source",
    "qa:full": "npm run qa && npm run test:db && npm run test:e2e && npm run test:a11y && npm run visual && npm run test:pwa-upgrade && npm run security:audit && npm run lighthouse && npm run pagespeed && npm run test:integrations && npm run verify:release",
    "coverage:critical": "npm run coverage:node",
    "test:a11y": "npm run build && npm run test:a11y:run",
    "catalog:generate": "node --experimental-strip-types scripts/sync-product-catalog.mjs",
    "validate:cloud-readiness": "node scripts/validate-cloud-readiness.mjs",
    "test:db": "node scripts/test-db.mjs",
    "validate:seo": "node scripts/validate-seo.mjs",
    "test:e2e:external": "npm run test:e2e:run",
    "test:debug": "node --test --test-concurrency=1 tests/*.test.js",
    "verify:release": "npm run release:evidence && npm run release:evidence:verify && node scripts/verify-production-release.mjs",
    "validate:world-class": "node --experimental-strip-types scripts/validate-world-class.mjs",
    "validate:performance-budget": "node scripts/validate-performance-budget.mjs",
    "quality:gate": "npm run qa:full",
    "test:core": "node --experimental-strip-types scripts/run-core-smoke-tests.mjs",
    "validate:static-integrity": "node scripts/validate-static-integrity.mjs",
    "validate:final-hardening": "node --experimental-strip-types scripts/validate-final-hardening.mjs",
    "e2e": "npm run test:e2e",
    "accessibility": "npm run test:a11y",
    "visual": "npm run build && npm run visual:run",
    "security:audit": "node scripts/security-audit.mjs && node scripts/run-dependency-audit.mjs && npm run security:sbom",
    "typecheck:strict-critical": "tsc -p tsconfig.strict-critical.json --noEmit",
    "prebuild": "node --experimental-strip-types scripts/sync-csp-jsonld-hashes.mjs",
    "test:node": "node scripts/run-node-tests.mjs",
    "quality:install": "node scripts/install-quality-toolchain.mjs",
    "lint:eslint": "eslint src api e2e tests scripts --max-warnings=0",
    "test:ui": "vitest run --config vitest.config.mjs",
    "coverage:node": "node scripts/run-coverage.mjs --critical",
    "coverage:project": "vitest run --config vitest.config.mjs --coverage && node scripts/audit-coverage-scope.mjs",
    "typecheck:production": "tsc -p tsconfig.production.json --noEmit",
    "postbuild": "node --experimental-strip-types scripts/generate-static-pages.mjs && node scripts/generate-build-provenance.mjs",
    "test:integrations": "node --experimental-strip-types scripts/verify-live-integrations.mjs",
    "security:sbom": "cyclonedx-npm --output-file reports/sbom.cdx.json --output-format JSON --omit dev",
    "verify:source": "npm run validate:data && npm run validate:phase1-truth && npm run validate:phase2-systems && npm run validate:phase3-release && npm run validate:independent-final && npm run validate:commerce && npm run validate:brand && npm run validate:media && npm run validate:seo && npm run validate:cloud-readiness && npm run validate:world-class && npm run validate:performance-budget && npm run validate:static-integrity && npm run validate:design-tokens && npm run generate:product-viewer-matrix && npm run validate:final-hardening && npm run validate:catalog-completeness && npm run validate:factory-readiness && npm run validate:arabic-review && npm run validate:provider-readiness && npm run validate:visual-baselines && npm run validate:action-pinning && npm run test:core && node scripts/check-source.mjs",
    "validate:design-tokens": "node scripts/validate-design-tokens.mjs",
    "generate:product-viewer-matrix": "node --experimental-strip-types scripts/generate-product-viewer-matrix.mjs",
    "validate:catalog-completeness": "node --experimental-strip-types scripts/validate-catalog-completeness.mjs",
    "validate:factory-readiness": "node --experimental-strip-types scripts/validate-factory-readiness.mjs",
    "test:pwa-upgrade": "node scripts/run-pwa-upgrade.mjs",
    "test:e2e:run": "node scripts/run-browser-tests.mjs e2e/shababuna.spec.js e2e/browser-contract-workflows.spec.js e2e/staging-live-workflows.spec.js",
    "test:a11y:run": "node scripts/run-browser-tests.mjs e2e/accessibility.spec.js",
    "visual:run": "npm run validate:visual-baselines && node scripts/run-browser-tests.mjs e2e/visual.spec.js",
    "audit:typescript": "node scripts/audit-typescript-strictness.mjs",
    "validate:arabic-review": "node --experimental-strip-types scripts/validate-arabic-review.mjs",
    "validate:visual-baselines": "node scripts/validate-visual-baselines.mjs",
    "validate:provider-readiness": "node scripts/validate-provider-readiness.mjs",
    "visual:update": "playwright test e2e/visual.spec.js --update-snapshots",
    "pagespeed:mobile": "node scripts/lighthouse/run-pagespeed.mjs mobile",
    "pagespeed:desktop": "node scripts/lighthouse/run-pagespeed.mjs desktop",
    "pagespeed:validate": "node scripts/lighthouse/validate-pagespeed.mjs",
    "pagespeed": "npm run pagespeed:mobile && npm run pagespeed:desktop && npm run pagespeed:validate",
    "test:matrix": "node scripts/generate-test-matrix.mjs",
    "quality:verify": "node scripts/validate-quality-toolchain.mjs",
    "quality:evidence": "node scripts/run-quality-evidence.mjs",
    "release:evidence": "node scripts/generate-release-evidence.mjs",
    "release:evidence:verify": "node scripts/verify-release-evidence.mjs",
    "test:e2e:isolation": "node scripts/assert-e2e-isolation.mjs",
    "test:e2e:contracts": "BROWSER_CONTRACT_E2E=true node scripts/run-browser-tests.mjs e2e/browser-contract-workflows.spec.js",
    "test:e2e:staging-live": "npm run test:e2e:isolation && STAGING_LIVE_E2E=true node scripts/run-browser-tests.mjs e2e/staging-live-workflows.spec.js",
    "validate:action-pinning": "node scripts/validate-action-pinning.mjs",
    "test:malware-pipeline": "node scripts/verify-malware-pipeline.mjs",
    "validate:product-master": "node --experimental-strip-types scripts/validate-product-master.mjs",
    "verify:build-provenance": "node scripts/verify-build-provenance.mjs",
    "verify:release-evidence-sha": "node scripts/verify-release-evidence-sha.mjs",
    "postinstall": "node scripts/ensure-offscreencanvas-types.mjs",
    "media:manifest": "node scripts/generate-media-manifest.mjs",
    "validate:architecture": "node --experimental-strip-types scripts/validate-world-class.mjs",
    "validate:phase1-truth": "node --experimental-strip-types scripts/validate-phase1-truth.mjs",
    "validate:phase2-systems": "node scripts/validate-phase2-systems.mjs",
    "validate:phase3-release": "node --experimental-strip-types scripts/validate-phase3-release.mjs",
    "validate:independent-final": "node --experimental-strip-types scripts/validate-independent-final.mjs"
  },
  "dependencies": {
    "@google/model-viewer": "^3.5.0",
    "@react-three/fiber": "^8.17.10",
    "@supabase/supabase-js": "2.110.6",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-helmet-async": "2.0.5",
    "react-router-dom": "6.30.4",
    "three": "0.163.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@cyclonedx/cyclonedx-npm": "6.0.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.4",
    "@types/node": "26.2.0",
    "@types/react": "18.3.27",
    "@types/react-dom": "18.3.7",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "6.0.5",
    "@vitest/coverage-v8": "4.1.10",
    "axe-core": "4.13.0",
    "eslint": "10.8.1",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-promise": "7.3.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-security": "4.0.1",
    "eslint-plugin-unicorn": "73.0.0",
    "globals": "17.11.0",
    "jsdom": "30.0.1",
    "lighthouse": "13.4.1",
    "playwright": "1.62.1",
    "prettier": "3.9.6",
    "stylelint": "17.14.1",
    "stylelint-config-standard": "40.0.0",
    "typescript": "7.0.2",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.1",
    "vitest": "3.2.4",
    "word-wrap": "file:vendor/word-wrap",
    "yallist": "file:vendor/yallist",
    "yocto-queue": "file:vendor/yocto-queue"
  },
  "overrides": {
    "yocto-queue": "$yocto-queue"
  },
  "engines": {
    "node": "22.x",
    "npm": "10.x"
  },
  "packageManager": "npm@10.9.2"
}
